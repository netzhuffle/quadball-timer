[Unit]
Description=Quadball Timer Test Environment Bun server
After=network.target

[Service]
Type=simple
User=quadball-timer-test
Group=quadball-timer-test
WorkingDirectory=/srv/quadball-timer-test/current
Environment=NODE_ENV=production
Environment=QUADBALL_ENVIRONMENT=test
Environment=PUBLIC_ORIGIN=https://test.timer.quadball.app
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=TECHNICAL_ADMIN_DATABASE=/var/lib/quadball-timer-test/technical-admin.sqlite
Environment=FOUNDATION_DATABASE=/var/lib/quadball-timer-test/foundation.sqlite
Environment=EVENT_GAME_DATABASE=/var/lib/quadball-timer-test/event-game.sqlite
Environment=GRANT_KEY_RING_FILE=/etc/quadball-timer/test-grant-key-ring.json
EnvironmentFile=/etc/quadball-timer/test.env
StateDirectory=quadball-timer-test
StateDirectoryMode=0750
RuntimeDirectory=quadball-timer-test
RuntimeDirectoryMode=0750
ExecStart=/srv/quadball-timer-test/current/quadball-timer
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
UMask=027

[Install]
WantedBy=multi-user.target
